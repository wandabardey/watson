{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Droits de la fenêtre principale",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/*" }, { "url": "https://*.github.com/*" }]
    }
  ]
}
