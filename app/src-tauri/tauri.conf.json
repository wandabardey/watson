{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Watson",
  "version": "0.8.0",
  "identifier": "fr.4sh.watson",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Watson",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 700,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ipc: http://ipc.localhost; img-src 'self' data: https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/watson-moteur"
    ],
    "category": "Productivity",
    "shortDescription": "Le référentiel métier vivant",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/wandabardey/watson/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExRkZFQUY1RTJCRTk0QTYKUldTbWxMN2k5ZXIvb2RCai9sRnFCYWRtNFJLT3NKT2RpbHVhbk1jSkpPSi8vYm5oZzFGSVhWRmEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
